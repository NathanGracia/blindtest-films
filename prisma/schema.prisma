generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Category {
  id     String  @id
  name   String
  icon   String
  color  String
  tracks Track[]
}

model Track {
  id              Int      @id @default(autoincrement())
  title           String   // Titre VO (version originale)
  titleVF         String?  // Titre VF (version française)
  acceptedAnswers String   // Stocké en JSON
  audioFile       String
  imageFile       String?
  timeLimit       Int      @default(30)
  startTime       Int      @default(0)  // Seconde de départ de la musique
  reportCount     Int      @default(0) // Nombre de signalements
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
}

model LadderEntry {
  id          Int      @id @default(autoincrement())
  pseudo      String                              // Normalisé en minuscules
  bestScore   Int                                 // Meilleur score de la semaine
  weekId      String                              // Format: "2026-W04" (ISO week)
  lastGameAt  DateTime @default(now())            // Dernière mise à jour
  gamesPlayed Int      @default(1)                // Nombre de parties jouées

  @@unique([pseudo, weekId])                      // Un pseudo = une entrée par semaine
  @@index([weekId, bestScore(sort: Desc)])        // Performance pour Top 10
}
